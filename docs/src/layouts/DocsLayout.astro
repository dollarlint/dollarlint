---
import Logo from "../components/Logo.astro";
import "../styles/dollar.css";

const {
  title = "dollarlint docs",
  description = "Documentation for the dollarlint CLI.",
  current = "/",
} = Astro.props;

const nav = [
  {
    heading: "Guides",
    links: [
      { href: "/", label: "Overview" },
      { href: "/guides/installation/", label: "Installation" },
      { href: "/guides/quick-start/", label: "Quick start" },
      { href: "/guides/schema-declarations/", label: "Schema declarations" },
      { href: "/guides/ignore-rules/", label: "Ignore rules" },
      { href: "/guides/schemastore/", label: "Catalogs" },
      { href: "/guides/mcp/", label: "MCP server" },
      { href: "/guides/examples/", label: "Examples" },
    ],
  },
  {
    heading: "Reference",
    links: [
      { href: "/reference/cli/", label: "Command Line" },
      { href: "/reference/configuration/", label: "Configuration" },
      { href: "/reference/output/", label: "Output formats" },
      { href: "/reference/exit-codes/", label: "Exit codes" },
    ],
  },
];

const currentLabel =
  nav.flatMap((section) => section.links).find((link) => link.href === current)
    ?.label ?? "Menu";
const currentPageLabel = current === "/guides/" ? "Guides" : currentLabel;
const slogans = [
  ["Put your money", "where your schema is"],
  ["Time to audit", "those configs"],
  ["Balance your", "config books"],
  ["Make every", "schema count"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script is:inline>
      const storedTheme = localStorage.getItem("dollarlint-theme") || "system";
      const themeQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const resolveTheme = (theme) =>
        theme === "system" ? (themeQuery.matches ? "dark" : "light") : theme;
      const applyTheme = (theme) => {
        const resolved = resolveTheme(theme);
        document.documentElement.dataset.themeChoice = theme;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.style.colorScheme = resolved;
      };
      const sloganOptions = [
        ["Put your money", "where your schema is"],
        ["Time to audit", "those configs"],
        ["Balance your", "config books"],
        ["Make every", "schema count"],
      ];
      window.__dollarlintSlogan =
        sloganOptions[Math.floor(Math.random() * sloganOptions.length)];
      applyTheme(storedTheme);
      themeQuery.addEventListener("change", () => {
        const currentTheme =
          localStorage.getItem("dollarlint-theme") || "system";
        applyTheme(currentTheme);
      });
      window.addEventListener("DOMContentLoaded", () => {
        const buttons = document.querySelectorAll("[data-theme-option]");
        const setPressed = (theme) => {
          buttons.forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.themeOption === theme),
            );
          });
        };
        setPressed(storedTheme);
        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const theme = button.dataset.themeOption;
            localStorage.setItem("dollarlint-theme", theme);
            applyTheme(theme);
            setPressed(theme);
          });
        });
        const menu = document.querySelector("[data-mobile-menu]");
        const menuButton = document.querySelector("[data-mobile-menu-button]");
        const menuPanel = document.querySelector("[data-mobile-menu-panel]");
        const sidebar = document.querySelector(".sidebar");
        const closeMenu = () => {
          menu?.removeAttribute("data-open");
          document.documentElement.removeAttribute("data-menu-open");
          document.documentElement.style.removeProperty("--mobile-menu-top");
          menuButton?.setAttribute("aria-expanded", "false");
          menuPanel?.setAttribute("hidden", "");
        };
        const openMenu = () => {
          const menuTop = sidebar?.getBoundingClientRect().bottom ?? 0;
          document.documentElement.style.setProperty(
            "--mobile-menu-top",
            `${menuTop}px`,
          );
          menu?.setAttribute("data-open", "true");
          document.documentElement.setAttribute("data-menu-open", "true");
          menuButton?.setAttribute("aria-expanded", "true");
          menuPanel?.removeAttribute("hidden");
        };
        menuButton?.addEventListener("click", () => {
          const isOpen = menu?.hasAttribute("data-open");
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });
        document.addEventListener("click", (event) => {
          if (!menu?.contains(event.target)) {
            closeMenu();
          }
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeMenu();
          }
        });
      });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700;800&family=Fjord+One&display=block"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={[current === "/" && "is-home"]}>
    <div class="site-shell">
      <aside class="sidebar" aria-label="Documentation">
        <div class="sidebar-header">
          <a class="brand" href="/">
            <Logo class="brand-logo" />
            <span>
              <span class="brand-title">dollarlint</span>
              <span
                class="brand-subtitle"
                data-slogan
                aria-label={slogans[0].join(" ")}
              >
                <span data-slogan-line>{slogans[0][0]}</span>
                <span data-slogan-line>{slogans[0][1]}</span>
              </span>
            </span>
          </a>
          <script is:inline>
            (() => {
              const slogan =
                document.currentScript.previousElementSibling?.querySelector(
                  "[data-slogan]",
                );
              const lines = window.__dollarlintSlogan;
              if (!slogan || !Array.isArray(lines)) return;
              slogan.setAttribute("aria-label", lines.join(" "));
              slogan
                .querySelectorAll("[data-slogan-line]")
                .forEach((line, index) => {
                  line.textContent = lines[index] || "";
                });
            })();
          </script>
          <div class="mobile-menu" data-mobile-menu>
            <button
              class="mobile-menu-trigger"
              type="button"
              aria-label={`Menu, current page: ${currentPageLabel}`}
              aria-controls="mobile-docs-menu"
              aria-expanded="false"
              data-mobile-menu-button
            >
              <span class="sr-only">Menu</span>
              <span class="menu-icon" aria-hidden="true"
                ><span></span><span></span><span></span></span
              >
            </button>
            <div
              class="mobile-menu-panel"
              id="mobile-docs-menu"
              data-mobile-menu-panel
              hidden
            >
              <div class="mobile-menu-current">{currentPageLabel}</div>
              <div class="mobile-menu-scroll">
                {
                  nav.map((section) => (
                    <nav
                      class="mobile-nav-section"
                      aria-label={`${section.heading} mobile`}
                    >
                      <div class="nav-heading">{section.heading}</div>
                      <ul class="nav-list">
                        {section.links.map((link) => (
                          <li>
                            <a
                              class="nav-link"
                              href={link.href}
                              aria-current={
                                current === link.href ? "page" : undefined
                              }
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </nav>
                  ))
                }
              </div>
              <div class="mobile-theme">
                <div class="theme-switch" role="group" aria-label="Theme">
                  <button
                    class="theme-button"
                    type="button"
                    data-theme-option="light"
                    aria-pressed="false">Light</button
                  >
                  <button
                    class="theme-button"
                    type="button"
                    data-theme-option="dark"
                    aria-pressed="false">Dark</button
                  >
                  <button
                    class="theme-button"
                    type="button"
                    data-theme-option="system"
                    aria-pressed="true">System</button
                  >
                </div>
                <a
                  class="utility-link"
                  href="https://github.com/agorischek/dollarlint">GitHub</a
                >
              </div>
            </div>
          </div>
        </div>
        {
          nav.map((section) => (
            <nav class="nav-section" aria-label={section.heading}>
              <div class="nav-heading">{section.heading}</div>
              <ul class="nav-list">
                {section.links.map((link) => (
                  <li>
                    <a
                      class="nav-link"
                      href={link.href}
                      aria-current={current === link.href ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
        <div class="sidebar-theme">
          <div class="theme-switch" role="group" aria-label="Theme">
            <button
              class="theme-button"
              type="button"
              data-theme-option="light"
              aria-pressed="false">Light</button
            >
            <button
              class="theme-button"
              type="button"
              data-theme-option="dark"
              aria-pressed="false">Dark</button
            >
            <button
              class="theme-button"
              type="button"
              data-theme-option="system"
              aria-pressed="true">System</button
            >
          </div>
          <a
            class="utility-link"
            href="https://github.com/agorischek/dollarlint">GitHub</a
          >
        </div>
      </aside>
      <main class="content">
        <div class="page">
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
