---
import Logo from "../components/Logo.astro";
import "../styles/dollar.css";

const {
  title = "Docs",
  description = "Documentation for the DollarLint CLI.",
  current = "/",
} = Astro.props;

const siteTitle = "DollarLint";
const documentTitle = current === "/" ? siteTitle : `${title} · ${siteTitle}`;

const nav = [
  {
    heading: "Guides",
    links: [
      { href: "/", label: "Overview" },
      { href: "/guides/installation/", label: "Installation" },
      { href: "/guides/quick-start/", label: "Quick start" },
      { href: "/guides/schema-declarations/", label: "Schema declarations" },
      { href: "/guides/ignore-rules/", label: "Ignore rules" },
      { href: "/guides/catalogs/", label: "Catalogs" },
      { href: "/guides/github-action/", label: "GitHub Action" },
      { href: "/guides/mcp/", label: "MCP server" },
    ],
  },
  {
    heading: "Reference",
    links: [
      { href: "/reference/cli/", label: "Command Line" },
      { href: "/reference/configuration/", label: "Configuration" },
      { href: "/reference/output/", label: "Output formats" },
      { href: "/reference/exit-codes/", label: "Exit codes" },
    ],
  },
];

const currentLabel =
  nav.flatMap((section) => section.links).find((link) => link.href === current)
    ?.label ?? "Menu";
const currentPageLabel = current === "/guides/" ? "Guides" : currentLabel;
const navLinks = nav.flatMap((section) => section.links);
const currentIndex = navLinks.findIndex((link) => link.href === current);
const previousPage =
  current !== "/" && currentIndex > 0 ? navLinks[currentIndex - 1] : undefined;
const nextPage =
  current !== "/" && currentIndex >= 0 && currentIndex < navLinks.length - 1
    ? navLinks[currentIndex + 1]
    : undefined;
const slogans = [
  ["Put your money", "where your schema is"],
  ["Time to audit", "those configs"],
  ["Balance your", "config books"],
  ["Make every", "schema count"],
  ["Making cents of", "your configs"],
  ["The buck stops", "at $schema"],
  ["In schemas", "we trust"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const themeQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const getStoredTheme = () => {
          try {
            return localStorage.getItem("dollarlint-theme") || "system";
          } catch {
            return "system";
          }
        };
        const resolveTheme = (theme) =>
          theme === "system" ? (themeQuery.matches ? "dark" : "light") : theme;
        const applyTheme = (theme) => {
          const resolved = resolveTheme(theme);
          root.dataset.themeChoice = theme;
          root.dataset.theme = resolved;
          root.style.colorScheme = resolved;
        };

        const sloganCount = 7;
        const sloganIndex = Math.floor(Math.random() * sloganCount);
        root.dataset.sloganIndex = String(sloganIndex);

        const zones = [
          { x: [10, 16], y: [11, 17] },
          { x: [80, 88], y: [14, 20] },
          { x: [50, 58], y: [74, 80] },
          { x: [86, 94], y: [76, 84] },
        ];
        const rand = ([min, max]) => min + Math.random() * (max - min);
        const runtimeStyle = document.createElement("style");
        runtimeStyle.id = "dollarlint-runtime-style";
        runtimeStyle.textContent = [
          `html[data-slogan-index="${sloganIndex}"] .brand-subtitle .brand-slogan[data-slogan-option="${sloganIndex}"]{display:block}`,
          ...zones.map(
            (zone, index) =>
              `.hero-mark:nth-child(${index + 1}){--mark-x:${rand(
                zone.x,
              ).toFixed(
                2,
              )}%;--mark-y:${rand(zone.y).toFixed(2)}%;--mark-rotate:${rand([
                -45, 45,
              ]).toFixed(2)}deg}`,
          ),
        ].join("");
        document.head.append(runtimeStyle);

        applyTheme(getStoredTheme());
        themeQuery.addEventListener("change", () => {
          const currentTheme = getStoredTheme();
          if (currentTheme === "system") {
            applyTheme(currentTheme);
          }
        });
        window.__dollarlintTheme = { apply: applyTheme, get: getStoredTheme };
      })();
      window.addEventListener("DOMContentLoaded", () => {
        const buttons = document.querySelectorAll("[data-theme-option]");
        const storedTheme =
          window.__dollarlintTheme?.get?.() ||
          document.documentElement.dataset.themeChoice ||
          "system";
        const setPressed = (theme) => {
          buttons.forEach((button) => {
            button.setAttribute(
              "aria-pressed",
              String(button.dataset.themeOption === theme),
            );
          });
        };
        setPressed(storedTheme);
        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const theme = button.dataset.themeOption;
            try {
              localStorage.setItem("dollarlint-theme", theme);
            } catch {}
            window.__dollarlintTheme?.apply?.(theme);
            setPressed(theme);
          });
        });
        const copyText = async (value, button) => {
          if (!value) return;
          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(value);
            } else {
              throw new Error("Clipboard API unavailable");
            }
            button.textContent = "Copied";
          } catch {
            const fallback = document.createElement("textarea");
            fallback.value = value;
            fallback.setAttribute("readonly", "");
            fallback.style.position = "fixed";
            fallback.style.top = "-1000px";
            document.body.append(fallback);
            fallback.select();
            const legacyDocument =
              /** @type {{ execCommand(command: string): boolean }} */ (
                document
              );
            button.textContent = legacyDocument.execCommand("copy")
              ? "Copied"
              : "Copy failed";
            fallback.remove();
          }
          window.setTimeout(() => {
            button.textContent = "Copy";
          }, 1400);
        };
        document.querySelectorAll("[data-copy-button]").forEach((button) => {
          button.addEventListener("click", () => {
            copyText(button.dataset.copyValue, button);
          });
        });
        const menu = document.querySelector("[data-mobile-menu]");
        const menuButton = document.querySelector("[data-mobile-menu-button]");
        const menuPanel = document.querySelector("[data-mobile-menu-panel]");
        const sidebar = document.querySelector(".sidebar");
        const closeMenu = () => {
          menu?.removeAttribute("data-open");
          document.documentElement.removeAttribute("data-menu-open");
          document.documentElement.style.removeProperty("--mobile-menu-top");
          menuButton?.setAttribute("aria-expanded", "false");
          menuPanel?.setAttribute("hidden", "");
        };
        const openMenu = () => {
          const menuTop = sidebar?.getBoundingClientRect().bottom ?? 0;
          document.documentElement.style.setProperty(
            "--mobile-menu-top",
            `${menuTop}px`,
          );
          menu?.setAttribute("data-open", "true");
          document.documentElement.setAttribute("data-menu-open", "true");
          menuButton?.setAttribute("aria-expanded", "true");
          menuPanel?.removeAttribute("hidden");
        };
        menuButton?.addEventListener("click", () => {
          const isOpen = menu?.hasAttribute("data-open");
          if (isOpen) {
            closeMenu();
          } else {
            openMenu();
          }
        });
        document.addEventListener("click", (event) => {
          if (!menu?.contains(event.target)) {
            closeMenu();
          }
        });
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") {
            closeMenu();
          }
        });
      });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:wght@400;500;600;700;800&family=Fjord+One&display=block"
      rel="stylesheet"
    />
    <style is:inline>
      :root {
        --install-bg: #fff7d6;
        --install-bg-soft: #f1dda1;
        --install-fg: #3a2b0f;
        --install-muted: #6d5520;
        --install-border: rgba(179, 135, 40, 0.5);
      }

      html[data-theme="dark"] {
        --install-bg: #211a0d;
        --install-bg-soft: #332811;
        --install-fg: #f6eed1;
        --install-muted: #dfbd62;
        --install-border: rgba(223, 189, 98, 0.5);
      }

      .install-tabs {
        background: var(--install-bg);
        border-color: var(--install-border);
        color: var(--install-fg);
      }

      .install-tabs-list {
        background: var(--install-bg-soft);
      }
    </style>
    <link rel="icon" type="image/png" sizes="1024x1024" href="/site-icon.png" />
    <link rel="apple-touch-icon" sizes="1024x1024" href="/site-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{documentTitle}</title>
  </head>
  <body class:list={[current === "/" && "is-home"]}>
    <div class="site-shell">
      <aside class="sidebar" aria-label="Documentation">
        <div class="sidebar-header">
          <a class="brand" href="/">
            <Logo class="brand-logo" />
            <span>
              <span class="brand-title">DollarLint</span>
              <span class="brand-subtitle">
                {
                  slogans.map((slogan, index) => (
                    <span class="brand-slogan" data-slogan-option={index}>
                      <span>{slogan[0]}</span>
                      <span>{slogan[1]}</span>
                    </span>
                  ))
                }
              </span>
            </span>
          </a>
          <div class="mobile-menu" data-mobile-menu>
            <button
              class="mobile-menu-trigger"
              type="button"
              aria-label={`Menu, current page: ${currentPageLabel}`}
              aria-controls="mobile-docs-menu"
              aria-expanded="false"
              data-mobile-menu-button
            >
              <span class="sr-only">Menu</span>
              <span class="menu-icon" aria-hidden="true"
                ><span></span><span></span><span></span></span
              >
            </button>
            <div
              class="mobile-menu-panel"
              id="mobile-docs-menu"
              data-mobile-menu-panel
              hidden
            >
              <div class="mobile-menu-current">{currentPageLabel}</div>
              <div class="mobile-menu-scroll">
                {
                  nav.map((section) => (
                    <nav
                      class="mobile-nav-section"
                      aria-label={`${section.heading} mobile`}
                    >
                      <div class="nav-heading">{section.heading}</div>
                      <ul class="nav-list">
                        {section.links.map((link) => (
                          <li>
                            <a
                              class="nav-link"
                              href={link.href}
                              aria-current={
                                current === link.href ? "page" : undefined
                              }
                            >
                              {link.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </nav>
                  ))
                }
              </div>
              <div class="mobile-theme">
                <div class="theme-switch" role="group" aria-label="Theme">
                  <button
                    class="theme-button"
                    type="button"
                    data-theme-option="light"
                    aria-pressed="false">Light</button
                  >
                  <button
                    class="theme-button"
                    type="button"
                    data-theme-option="dark"
                    aria-pressed="false">Dark</button
                  >
                  <button
                    class="theme-button"
                    type="button"
                    data-theme-option="system"
                    aria-pressed="true">System</button
                  >
                </div>
                <a
                  class="utility-link"
                  href="https://github.com/dollarlint/dollarlint">GitHub</a
                >
              </div>
            </div>
          </div>
        </div>
        {
          nav.map((section) => (
            <nav class="nav-section" aria-label={section.heading}>
              <div class="nav-heading">{section.heading}</div>
              <ul class="nav-list">
                {section.links.map((link) => (
                  <li>
                    <a
                      class="nav-link"
                      href={link.href}
                      aria-current={current === link.href ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
        <div class="sidebar-theme">
          <div class="theme-switch" role="group" aria-label="Theme">
            <button
              class="theme-button"
              type="button"
              data-theme-option="light"
              aria-pressed="false">Light</button
            >
            <button
              class="theme-button"
              type="button"
              data-theme-option="dark"
              aria-pressed="false">Dark</button
            >
            <button
              class="theme-button"
              type="button"
              data-theme-option="system"
              aria-pressed="true">System</button
            >
          </div>
          <a
            class="utility-link"
            href="https://github.com/dollarlint/dollarlint">GitHub</a
          >
        </div>
      </aside>
      <main class="content">
        <div class="page">
          <slot />
          {
            (previousPage || nextPage) && (
              <nav class="doc-pagination" aria-label="Previous and next pages">
                {previousPage ? (
                  <a
                    class="doc-pagination-card previous"
                    href={previousPage.href}
                  >
                    <span>Previous</span>
                    <strong>{previousPage.label}</strong>
                  </a>
                ) : (
                  <span />
                )}
                {nextPage ? (
                  <a class="doc-pagination-card next" href={nextPage.href}>
                    <span>Next</span>
                    <strong>{nextPage.label}</strong>
                  </a>
                ) : (
                  <span />
                )}
              </nav>
            )
          }
        </div>
      </main>
    </div>
  </body>
</html>
