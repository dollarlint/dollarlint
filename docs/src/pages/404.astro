---
import DocsLayout from "../layouts/DocsLayout.astro";
---

<DocsLayout title="Page not found">
  <section class="not-found">
    <div class="not-found-mark">404</div>
    <h1>Missing tender</h1>
    <p>The page you requested is not in the docs ledger. Try the guide index or head back to the overview.</p>
    <div class="hero-actions">
      <a class="button primary" href="/guides/">Browse guides</a>
      <a class="button secondary" href="/">Back to overview</a>
    </div>
  </section>
</DocsLayout>
