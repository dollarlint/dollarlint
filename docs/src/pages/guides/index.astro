---
import DocsLayout from "../../layouts/DocsLayout.astro";

const guides = [
  {
    href: "/guides/installation/",
    title: "Installation",
    description: "Install the CLI and confirm it is available on your path.",
  },
  {
    href: "/install/agent/",
    title: "Agent install",
    description:
      "Token-light instructions for agents installing, configuring, validating, and summarizing findings.",
  },
  {
    href: "/guides/quick-start/",
    title: "Quick start",
    description:
      "Create a starter config, validate a directory, and choose an output format.",
  },
  {
    href: "/guides/schema-declarations/",
    title: "Schema declarations",
    description:
      "Declare schemas in JSON-family, YAML, and TOML files, or associate files from config.",
  },
  {
    href: "/guides/ignore-rules/",
    title: "Ignore rules",
    description:
      "Keep known validation errors visible without letting them fail the run.",
  },
  {
    href: "/guides/schemastore/",
    title: "Catalogs",
    description:
      "Infer schemas for well-known filenames with built-in or custom catalogs.",
  },
  {
    href: "/guides/github-action/",
    title: "GitHub Action",
    description:
      "Run DollarLint in CI, pin release archives, and upload SARIF to code scanning.",
  },
  {
    href: "/guides/mcp/",
    title: "MCP server",
    description:
      "Expose DollarLint validation to agents and editors through Model Context Protocol.",
  },
];
---

<DocsLayout title="Guides" current="/guides/">
  <article class="doc">
    <header class="doc-header">
      <span class="eyebrow">Guides</span>
      <h1>Guides</h1>
      <p class="lead">
        Start with the first run, then dig into schema declarations, catalogs,
        ignore rules, CI, and agent workflows.
      </p>
    </header>

    <div class="grid guide-grid">
      {
        guides.map((guide) => (
          <a class="card guide-card" href={guide.href}>
            <h3>{guide.title}</h3>
            <p>{guide.description}</p>
          </a>
        ))
      }
    </div>
  </article>
</DocsLayout>
