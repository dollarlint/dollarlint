---
import DocsLayout from "../layouts/DocsLayout.astro";
import LogoOutline from "../components/LogoOutline.astro";
---

<DocsLayout
  title="DollarLint documentation"
  description="Check JSON-family, YAML, and TOML files against their schemas locally and in CI."
  current="/"
>
  <section class="hero">
    <div class="hero-marks" aria-hidden="true">
      {
        Array.from({ length: 4 }).map(() => (
          <span class="hero-mark" data-hero-mark>
            <LogoOutline class="hero-mark-logo" />
          </span>
        ))
      }
    </div>
    <h1>DollarLint</h1>
    <p class="hero-copy">
      <code>$schema</code> validation for every JSON, YAML, &amp; TOML file you've
      got
    </p>
    <div class="install-tabs" data-install-tabs>
      <div class="install-tabs-list" role="tablist" aria-label="Install method">
        <button
          class="install-tab"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="install-homebrew"
          id="install-homebrew-tab"
          data-install-tab="homebrew"
        >
          Homebrew
        </button>
        <button
          class="install-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="install-npm"
          id="install-npm-tab"
          data-install-tab="npm"
        >
          npm
        </button>
        <button
          class="install-tab"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="install-go"
          id="install-go-tab"
          data-install-tab="go"
        >
          Go
        </button>
      </div>
      <div
        class="install-panel"
        role="tabpanel"
        id="install-homebrew"
        aria-labelledby="install-homebrew-tab"
        data-install-panel="homebrew"
      >
        <span aria-hidden="true">$</span><code
          >brew install --cask dollarlint/tap/dollarlint</code
        >
        <button class="install-copy" type="button" data-install-copy
          >Copy</button
        >
      </div>
      <div
        class="install-panel"
        role="tabpanel"
        id="install-npm"
        aria-labelledby="install-npm-tab"
        data-install-panel="npm"
        hidden
      >
        <span aria-hidden="true">$</span><code>npm install -g dollarlint</code>
        <button class="install-copy" type="button" data-install-copy
          >Copy</button
        >
      </div>
      <div
        class="install-panel"
        role="tabpanel"
        id="install-go"
        aria-labelledby="install-go-tab"
        data-install-panel="go"
        hidden
      >
        <span aria-hidden="true">$</span><code
          >go install github.com/dollarlint/dollarlint/cmd/dollarlint@latest</code
        >
        <button class="install-copy" type="button" data-install-copy
          >Copy</button
        >
      </div>
    </div>
    <div class="hero-actions">
      <a class="button primary" href="/guides/installation/">Get started</a>
      <a class="button secondary" href="/reference/configuration/"
        >Config reference</a
      >
    </div>
  </section>
  <script is:inline>
    (() => {
      const hero = document.currentScript.previousElementSibling;
      const marks = hero?.querySelectorAll("[data-hero-mark]");
      if (!marks?.length) return;

      const zones = [
        { x: [10, 16], y: [11, 17] },
        { x: [80, 88], y: [14, 20] },
        { x: [50, 58], y: [74, 80] },
        { x: [86, 94], y: [76, 84] },
      ];
      const rand = ([min, max]) => min + Math.random() * (max - min);

      marks.forEach((mark, index) => {
        const zone = zones[index % zones.length];
        mark.style.setProperty("--mark-x", `${rand(zone.x).toFixed(2)}%`);
        mark.style.setProperty("--mark-y", `${rand(zone.y).toFixed(2)}%`);
        mark.style.setProperty(
          "--mark-rotate",
          `${rand([-45, 45]).toFixed(2)}deg`,
        );
      });

      const installTabs = hero.querySelectorAll("[data-install-tab]");
      const installPanels = hero.querySelectorAll("[data-install-panel]");
      installTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const target = tab.dataset.installTab;
          installTabs.forEach((item) => {
            item.setAttribute(
              "aria-selected",
              String(item.dataset.installTab === target),
            );
          });
          installPanels.forEach((panel) => {
            panel.toggleAttribute(
              "hidden",
              panel.dataset.installPanel !== target,
            );
          });
        });
      });

      hero.querySelectorAll("[data-install-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const command = button.parentElement
            ?.querySelector("code")
            ?.textContent?.trim();
          if (!command) return;
          try {
            await navigator.clipboard.writeText(command);
            button.textContent = "Copied";
            window.setTimeout(() => {
              button.textContent = "Copy";
            }, 1400);
          } catch {
            button.textContent = "Copy failed";
            window.setTimeout(() => {
              button.textContent = "Copy";
            }, 1400);
          }
        });
      });
    })();
  </script>

  <section class="grid" aria-label="Highlights">
    <article class="card">
      <h3>Repo-wide discovery</h3>
      <p>
        Find JSON-family, YAML, and TOML files automatically, respect your
        excludes, and validate matched files in parallel.
      </p>
    </article>
    <article class="card">
      <h3>Any schema source</h3>
      <p>
        Use explicit in-file declarations, config associations, or catalog
        inference. Schemas can live beside your files or across the network.
      </p>
    </article>
    <article class="card">
      <h3>Local &amp; CI</h3>
      <p>
        Styled text for terminals, structured JSON for scripts, SARIF 2.1.0 for
        code scanning, and predictable exit codes for automation.
      </p>
    </article>
    <article class="card">
      <h3>Ignore known issues</h3>
      <p>
        Suppress known validation issues by location or pointer while keeping
        the rest of the file under schema coverage.
      </p>
    </article>
    <article class="card">
      <h3>Tooling for agents</h3>
      <p>
        Expose validation through MCP as a structured local tool for editors and
        agents, with source locations included automatically.
      </p>
    </article>
    <article class="card">
      <h3>Fast by design</h3>
      <p>
        Prune complex schemas before compilation so large catalogs and cloud
        resource definitions stay practical to validate.
      </p>
    </article>
  </section>

  <section class="command-section">
    <div class="section-rule" aria-hidden="true"></div>
    <div class="command-list">
      <div class="command">
        <code>dollarlint init</code>
        <p>
          Mint a starter <code>.dollarlint.toml</code> in the current directory.
        </p>
      </div>
      <div class="command">
        <code>dollarlint validate .</code>
        <p>
          Audit every supported JSON-family, YAML, and TOML file under the
          current directory.
        </p>
      </div>
      <div class="command">
        <code
          >dollarlint validate ./config <span class="no-break">--locations</span
          ></code
        >
        <p>
          Show the line, column, and pointer for each issue so fixes start in
          the right place.
        </p>
      </div>
      <div class="command">
        <code
          >dollarlint validate . <span class="no-break">--format</span> sarif <span
            class="no-break">--output</span
          > dollarlint.sarif</code
        >
        <p>Generate a CI-friendly code scanning artifact.</p>
      </div>
    </div>
  </section>
</DocsLayout>
