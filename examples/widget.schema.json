{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/dollarlint/widget.schema.json",
  "type": "object",
  "required": ["name", "count", "enabled"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
