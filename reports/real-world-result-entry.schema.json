{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dollarlint/dollarlint/reports/real-world-result-entry.schema.json",
  "title": "DollarLint real-world test result entry",
  "description": "A single DollarLint real-world repository sweep result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "date",
    "title",
    "dollarlintRevision",
    "corpus",
    "command",
    "outputArtifact",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../real-world-result-entry.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 3
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "dollarlintRevision": {
      "type": "string",
      "minLength": 1
    },
    "workingTreeNote": {
      "type": "string"
    },
    "corpus": {
      "type": "string",
      "minLength": 1
    },
    "cacheDir": {
      "type": "string"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "outputArtifact": {
      "type": "string",
      "minLength": 1
    },
    "persistedOutputArtifact": {
      "type": "string",
      "pattern": "^reports/real-world-artifacts/[^/]+\\.dollarlint\\.json$"
    },
    "repositories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repository"
      }
    },
    "dependencyPrep": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependencyPrep"
      }
    },
    "validationFeedback": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/validationFeedback"
      }
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "beforeResult": {
      "$ref": "#/$defs/result"
    },
    "findings": {
      "$ref": "#/$defs/stringList"
    },
    "productRecommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productRecommendation"
      }
    },
    "productDecisions": {
      "$ref": "#/$defs/stringList"
    },
    "followUp": {
      "$ref": "#/$defs/stringList"
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cloneURL"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ecosystem": {
          "type": "string"
        },
        "cloneURL": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "alreadyTested": {
          "type": "boolean"
        },
        "previousEntries": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "dependencyPrep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "output": {
          "type": "string"
        }
      }
    },
    "productRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strength", "recommendation", "rationale"],
      "properties": {
        "strength": {
          "type": "string",
          "enum": ["high", "med", "low"]
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validationFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "outcome"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "enum": ["behaved-reasonably", "product-signal", "blocked"]
        },
        "findings": {
          "$ref": "#/$defs/stringList"
        },
        "productRecommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/productRecommendation"
          }
        },
        "productDecisions": {
          "$ref": "#/$defs/stringList"
        },
        "caveats": {
          "$ref": "#/$defs/stringList"
        },
        "followUp": {
          "$ref": "#/$defs/stringList"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered",
        "validated",
        "skipped",
        "failed",
        "issues",
        "warnings"
      ],
      "properties": {
        "discovered": {
          "$ref": "#/$defs/count"
        },
        "validated": {
          "$ref": "#/$defs/count"
        },
        "skipped": {
          "$ref": "#/$defs/count"
        },
        "failed": {
          "$ref": "#/$defs/count"
        },
        "issues": {
          "$ref": "#/$defs/issueSummary"
        },
        "ignored": {
          "$ref": "#/$defs/count"
        },
        "warnings": {
          "$ref": "#/$defs/count"
        },
        "duration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nanos": {
              "$ref": "#/$defs/count"
            }
          }
        }
      }
    },
    "issueSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "parsing", "validation", "schema", "coverage"],
      "properties": {
        "total": {
          "$ref": "#/$defs/count"
        },
        "parsing": {
          "$ref": "#/$defs/count"
        },
        "validation": {
          "$ref": "#/$defs/count"
        },
        "schema": {
          "$ref": "#/$defs/count"
        },
        "coverage": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
