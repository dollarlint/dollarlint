{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dollarlint/dollarlint/reports/real-world-results.schema.json",
  "title": "DollarLint real-world test result index",
  "description": "Lightweight index for split DollarLint real-world repository sweep results.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "entries"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./real-world-results.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 3
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entryRef"
      }
    }
  },
  "$defs": {
    "entryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "title", "path"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^reports/real-world-results/[^/]+\\.json$"
        },
        "repoCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
